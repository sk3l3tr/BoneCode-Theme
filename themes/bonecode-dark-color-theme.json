  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9586A6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B565F5"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#BAACCA"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A3DEC7"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#FFC581"
      }
    },
    {
      "name": "Constants and booleans",
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#F2A3C2"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#91BDF5"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#FFE878"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#FFF3C4"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E8DFF2"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#D6C4E8"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#C2A6E2"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#B6A6C4"
      }
    },
    {
      "name": "Interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#B565F5"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#FFC581"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FFE878"
      }
    },
    {
      "name": "Attributes and decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#B565F5"
      }
    },
    {
      "name": "CSS identifiers",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#91BDF5"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.json.comments"
      ],
      "settings": {
        "foreground": "#91BDF5"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FFE878",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#91BDF5",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#A3DEC7"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFF3C4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FFF3C4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Added lines",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#71E3B4"
      }
    },
    {
      "name": "Deleted lines",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF899A"
      }
    },
    {
      "name": "Changed lines",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFC581"
      }
    },
    {
      "name": "Invalid tokens",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFB0BB",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#C2A6E2",
    "type": "#91BDF5",
    "class": "#91BDF5",
    "enum": "#91BDF5",
    "interface": "#91BDF5",
    "struct": "#91BDF5",
    "typeParameter": "#91BDF5",
    "parameter": "#E8DFF2",
    "variable": "#FFF3C4",
    "property": "#D6C4E8",
    "enumMember": "#F2A3C2",
    "event": "#FFE878",
    "function": "#FFE878",
    "method": "#FFE878",
    "macro": "#B565F5",
    "keyword": "#B565F5",
    "modifier": "#B565F5",
    "comment": {
      "foreground": "#9586A6",
      "italic": true
    },
    "string": "#A3DEC7",
    "number": "#FFC581",
    "regexp": "#FFC581",
    "operator": "#BAACCA",
    "decorator": "#B565F5",
    "variable.readonly": "#F2A3C2",
    "property.readonly": "#D6C4E8",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
